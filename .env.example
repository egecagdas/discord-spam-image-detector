# Discord bot token from the Developer Portal
DISCORD_TOKEN=

# Optional: members with this role can use /spam even without Manage Server
# ADMIN_ROLE_ID=

# Matching: Hamming distance on a 64-bit pHash. Lower is stricter. Default 10.
# HASH_THRESHOLD=10

# Skip downloads larger than this (bytes). Default 10485760 (10 MB).
# MAX_IMAGE_BYTES=10485760

# LOG_LEVEL=INFO
